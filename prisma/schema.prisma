generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String
  price         Float
  originalPrice Float?
  description   String
  images        String   @default("[]")
  badge         String?
  sizes         String?
  colors        String?
  inStock       Boolean  @default(true)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model NewsletterSubscriber {
  id        String   @id @default(cuid())
  email     String   @unique
  createdAt DateTime @default(now())
}

model Customer {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  orders       Order[]
}

model Order {
  id         String      @id @default(cuid())
  number     String      @unique
  customerId String
  customer   Customer    @relation(fields: [customerId], references: [id], onDelete: Cascade)
  name       String
  email      String
  phone      String
  address    String
  city       String
  state      String
  pincode    String
  notes      String?
  subtotal   Float
  discount   Float       @default(0)
  shipping   Float       @default(0)
  total      Float
  coupon     String?
  status     String      @default("requested")
  items      OrderItem[]
  createdAt  DateTime    @default(now())

  @@index([customerId, createdAt])
}

model OrderItem {
  id        String  @id @default(cuid())
  orderId   String
  order     Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  name      String
  price     Float
  quantity  Int
  size      String?
  color     String?

  @@index([orderId])
}
