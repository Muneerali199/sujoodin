generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Product {
  id            String   @id @default(cuid())
  slug          String   @unique
  name          String
  category      String
  price         Float
  originalPrice Float?
  description   String
  images        String   @default("[]")
  badge         String?
  sizes         String?
  colors        String?
  inStock       Boolean  @default(true)
  featured      Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}
